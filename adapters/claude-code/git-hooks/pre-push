#!/bin/bash
# Global git pre-push hook dispatcher.
#
# This file is referenced by `git config --global core.hooksPath`
# so it runs on EVERY push from EVERY repo on this machine.
#
# What it does:
#   1. Runs the sensitive pattern scanner (blocks on credentials/business IDs)
#   2. Runs the test-gate (blocks pushes to master/main without a test-pass
#      receipt for the current HEAD, for repos that opted in via a
#      .claude/pre-push-test-gate.enabled marker file)
#   3. Runs the divergence check (blocks pushes to master/main when the
#      remote target ref has advanced since the local fetch)
#   4. Runs the review-record push gate (blocks pushes to master/main that
#      would land unreviewed harness content on the remote — the
#      AUTHORITATIVE carrier of review-before-deploy; see hooks/
#      review-record-push-gate.sh's own header for the full rationale.
#      review-record-commit-gate.sh, the PreToolUse commit-time carrier, is
#      advisory-only — this is the layer that actually enforces)
#   5. If the repo has a local hook at .git/hooks/pre-push.local, runs that too
#
# To bypass everything: git push --no-verify
# To bypass test-gate only: PT_PUSH_NO_TEST_GATE=1 git push

set -e

# Find the scanner (follows symlinks for cases where the file itself is linked)
HOOK_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
SCANNER="$HOOK_DIR/../hooks/pre-push-scan.sh"

# Fallback: try the canonical neural-lace install location
if [ ! -f "$SCANNER" ]; then
  if [ -f "$HOME/claude-projects/neural-lace/adapters/claude-code/hooks/pre-push-scan.sh" ]; then
    SCANNER="$HOME/claude-projects/neural-lace/adapters/claude-code/hooks/pre-push-scan.sh"
  else
    echo "WARNING: pre-push-scan.sh not found — scanner skipped" >&2
    SCANNER=""
  fi
fi

# Capture stdin once so every stage can replay it.
REF_INPUT=$(cat)

# 1. Run the scanner with the hook args and stdin
if [ -n "$SCANNER" ] && [ -f "$SCANNER" ]; then
  echo "$REF_INPUT" | bash "$SCANNER" "$@"
fi

# 2. Run the test-gate (opt-in via .claude/pre-push-test-gate.enabled in the repo)
TEST_GATE="$HOOK_DIR/../hooks/pre-push-test-gate.sh"
if [ ! -f "$TEST_GATE" ]; then
  if [ -f "$HOME/claude-projects/neural-lace/adapters/claude-code/hooks/pre-push-test-gate.sh" ]; then
    TEST_GATE="$HOME/claude-projects/neural-lace/adapters/claude-code/hooks/pre-push-test-gate.sh"
  else
    TEST_GATE=""
  fi
fi
if [ -n "$TEST_GATE" ] && [ -f "$TEST_GATE" ]; then
  echo "$REF_INPUT" | bash "$TEST_GATE" "$@"
fi

# 3. Run the divergence check (blocks master/main pushes when remote has advanced)
DIV_CHECK="$HOOK_DIR/../hooks/pre-push-divergence-check.sh"
if [ ! -f "$DIV_CHECK" ]; then
  if [ -f "$HOME/claude-projects/neural-lace/adapters/claude-code/hooks/pre-push-divergence-check.sh" ]; then
    DIV_CHECK="$HOME/claude-projects/neural-lace/adapters/claude-code/hooks/pre-push-divergence-check.sh"
  else
    DIV_CHECK=""
  fi
fi
if [ -n "$DIV_CHECK" ] && [ -f "$DIV_CHECK" ]; then
  echo "$REF_INPUT" | bash "$DIV_CHECK" "$@"
fi

# 4. Run the review-record push gate (AUTHORITATIVE — blocks unreviewed
#    harness content from reaching master/main; deterministic-process.md)
REVIEW_GATE="$HOOK_DIR/../hooks/review-record-push-gate.sh"
if [ ! -f "$REVIEW_GATE" ]; then
  if [ -f "$HOME/claude-projects/neural-lace/adapters/claude-code/hooks/review-record-push-gate.sh" ]; then
    REVIEW_GATE="$HOME/claude-projects/neural-lace/adapters/claude-code/hooks/review-record-push-gate.sh"
  else
    REVIEW_GATE=""
  fi
fi
if [ -n "$REVIEW_GATE" ] && [ -f "$REVIEW_GATE" ]; then
  echo "$REF_INPUT" | bash "$REVIEW_GATE" "$@"
else
  echo "WARNING: review-record-push-gate.sh not found — the AUTHORITATIVE review-record gate did NOT run for this push" >&2
fi

# 5. Run any local repo-specific pre-push hook
LOCAL_HOOK="$(git rev-parse --show-toplevel 2>/dev/null)/.git/hooks/pre-push.local"
if [ -f "$LOCAL_HOOK" ] && [ -x "$LOCAL_HOOK" ]; then
  echo "$REF_INPUT" | "$LOCAL_HOOK" "$@"
fi

exit 0
